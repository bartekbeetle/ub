# === BAZA DANYCH ===
# Produkcja (Supabase Postgres):
#   - aplikacja na Vercelu -> POOLER, transaction mode, port 6543
#   - migracje/seedy lokalnie -> DIRECT, port 5432
# Dev: zostaw puste -> aplikacja użyje wbudowanej bazy PGlite (plik ./.pglite)
DATABASE_URL=

# === APLIKACJA ===
# Publiczny URL (canonical, sitemap, OG). Bez trailing slasha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sekret do podpisywania sesji (min. 32 znaki, wygeneruj: openssl rand -hex 32)
SESSION_SECRET=

# === KONTO ADMINA (seed) ===
ADMIN_EMAIL=biuro@uniwersytetbeauty.pl
ADMIN_INITIAL_PASSWORD=

# === EMAIL ===
# BRAK KONFIGURACJI = maile do trenerek NIE WYCHODZĄ — lądują w tabeli email_queue
# ze statusem „oczekuje" i nikt ich nie wysyła. Powiadomienie o nowym leadzie nie dociera.
# Rekomendacja: konto SMTP w LH.pl (domena i tak tam stoi) albo Resend/Brevo.
#   LH.pl:  SMTP_HOST=smtp.lh.pl  SMTP_PORT=587  SMTP_USER=biuro@uniwersytetbeauty.pl
#   Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<api key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Uniwersytet Beauty <biuro@uniwersytetbeauty.pl>"

# === ANALITYKA (opcjonalne — brak = skrypty się nie ładują) ===
# WERSJA RUNTIME (zalecana na Coolify): czytane przy każdym żądaniu przez
# /api/analytics-config, więc wystarczy restart kontenera — bez przebudowy obrazu.
GA4_ID=
META_PIXEL_ID=
# WERSJA BUILD-TIME (fallback): działa tylko, gdy obraz był budowany z tymi zmiennymi.
# Zmiana wartości wymaga PEŁNEGO rebuildu, nie restartu.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
